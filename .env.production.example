# Szablon środowiska produkcyjnego. Na serwerze skopiuj jako .env (chmod 600) i uzupełnij puste pola.
# Nie wpisuj prawdziwych haseł do tego pliku i nie dodawaj gotowego .env do repozytorium.
# Opis całego wdrożenia: docs/DEPLOY.md

APP_NAME="Drzwi do Piękna"
APP_ENV=production
# php artisan key:generate --force (raz, przy pierwszym wdrożeniu; zmiana klucza wylogowuje wszystkich)
APP_KEY=
APP_DEBUG=false
# Domena główna bez www. Wchodzi do tagów canonical, mapy strony (sitemap.xml) i danych strukturalnych,
# więc musi być adresem docelowym (https), tym samym co w nginx i w Search Console.
APP_URL=https://drzwidopiekna.pl

APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL
BCRYPT_ROUNDS=12

# Maintenance dla php artisan down podczas wdrożenia (ekran 503 jest w resources/views/errors/503.blade.php)
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# PostgreSQL. Założenie bazy: docs/DEPLOY.md, punkt "Baza danych".
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=drzwi_do_piekna
DB_USERNAME=drzwi
DB_PASSWORD=

# Sesje i cache na plikach wystarczą dla jednego serwera. Formularz kontaktowy wysyła e-mail od razu
# (QUEUE_CONNECTION=sync), a awaria poczty nie gubi zgłoszenia, więc worker kolejki nie jest potrzebny.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Poczta: powiadomienie o zgłoszeniu z formularza trafia na adres z config/clinic.php (gabinet@drzwidopiekna.pl).
# Żeby wiadomości nie lądowały w spamie, domena potrzebuje rekordów SPF i DKIM u dostawcy poczty.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="gabinet@drzwidopiekna.pl"
MAIL_FROM_NAME="${APP_NAME}"
# Opcjonalnie: dokąd trafia powiadomienie o zgłoszeniu z formularza (domyślnie gabinet@drzwidopiekna.pl z config/clinic.php).
# Na stagingu wpisz własny adres, żeby testy formularza nie wysyłały maili do prawdziwej skrzynki gabinetu.
# CLINIC_NOTIFY_EMAIL=

# Rezerwacja online (przyciski "Umów wizytę"). Zostaw domyślny adres Moment.pl albo wpisz własny.
CLINIC_BOOKING_URL=https://www.moment.pl/drzwi-do-piekna

VITE_APP_NAME="${APP_NAME}"

# Dwuskładnikowe logowanie do panelu /admin jest wymagane w produkcji (każde konto po pierwszym logowaniu konfiguruje aplikację
# uwierzytelniającą). Nie zmieniaj na false: deploy/deploy.sh i tak zablokuje takie wdrożenie.
ADMIN_2FA_REQUIRED=true

# Konta panelu /admin zakłada się poleceniem: php artisan make:filament-user
# Zmiennych ADMIN_* nie ustawiaj w produkcji (seeder i tak ich tam nie używa).
